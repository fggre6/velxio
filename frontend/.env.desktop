# Tauri desktop build (Windows).
# The shell serves the SPA from http://127.0.0.1:<dynamic port>/ and the same
# FastAPI process serves /api/*, so the API base stays a same-origin path.
# The shell additionally injects window.__VELXIO_BACKEND__ and
# window.__VELXIO_API_BASE__ before the bundle runs.
VITE_DESKTOP=1
VITE_API_BASE=/api
